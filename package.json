{
  "name": "deadline-reminder",
  "version": "1.0.0",
  "description": "Local-first Chromium extension for tracking academic and personal deadlines with reminders.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "fixtures": "node scripts/build-fixtures.mjs",
    "smoke:import": "node scripts/smoke-import.mjs",
    "measure": "node scripts/measure.mjs",
    "package": "node scripts/package.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "release": "npm run check && npm run package",
    "release:check": "npm run build && npm run package && node scripts/smoke-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438"
  }
}
